---
import type { FaqGroup } from '../data/faq';

interface Props {
  groups: readonly FaqGroup[];
  /** グループ見出しを表示するか（TOP では非表示） */
  showGroupLabels?: boolean;
  /** 各グループから先頭何件を出すか */
  limitPerGroup?: number;
}

const { groups, showGroupLabels = true, limitPerGroup } = Astro.props;
---

<div class="faq">
  {
    groups.map((group) => (
      <section class="faq__group" aria-labelledby={`faq-${group.id}`}>
        {showGroupLabels ? (
          <h3 class="faq__group-title" id={`faq-${group.id}`}>
            <span class="label label--accent">{group.label}</span>
            <span class="faq__group-ja">{group.labelJa}</span>
          </h3>
        ) : (
          <h3 class="visually-hidden" id={`faq-${group.id}`}>
            {group.labelJa}
          </h3>
        )}

        <ul class="faq__list">
          {(limitPerGroup ? group.items.slice(0, limitPerGroup) : group.items).map((item) => (
            <li>
              <details class="faq__item">
                <summary class="faq__q">
                  <span class="faq__q-mark font-en" aria-hidden="true">Q</span>
                  <span class="faq__q-text">{item.q}</span>
                  <span class="faq__icon" aria-hidden="true" />
                </summary>
                <div class="faq__a">
                  <span class="faq__a-mark font-en" aria-hidden="true">A</span>
                  <p class="small">{item.a}</p>
                </div>
              </details>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .faq {
    display: grid;
    gap: clamp(2rem, 4vw, 3.25rem);
  }

  .faq__group-title {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin-bottom: var(--sp-s);
  }

  .faq__group-ja {
    font-size: var(--fs-small);
    color: var(--fg-muted);
    letter-spacing: 0.1em;
  }

  .faq__list {
    display: grid;
    border-block-start: 1px solid var(--line);
  }

  .faq__item {
    border-block-end: 1px solid var(--line);
  }

  .faq__q {
    display: grid;
    grid-template-columns: 1.75rem 1fr 1.5rem;
    align-items: baseline;
    gap: 0.75rem;
    padding-block: clamp(1rem, 2.2vw, 1.35rem);
    min-block-size: var(--tap-min);
    cursor: pointer;
    list-style: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__q:hover {
    color: var(--accent);
  }

  .faq__q-mark,
  .faq__a-mark {
    font-size: var(--fs-small);
    letter-spacing: 0.1em;
    color: var(--accent);
  }

  .faq__q-text {
    font-size: var(--fs-body);
    line-height: 1.7;
    letter-spacing: 0.04em;
  }

  /* ＋ / − のアイコン。CSS のみで開閉を表現する */
  .faq__icon {
    position: relative;
    inline-size: 0.85rem;
    block-size: 0.85rem;
    justify-self: end;
    translate: 0 0.2em;
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0;
    inline-size: 100%;
    block-size: 1px;
    background: currentColor;
    transition: rotate var(--dur-base) var(--ease-out), opacity var(--dur-base) var(--ease-out);
  }

  .faq__icon::after {
    rotate: 90deg;
  }

  .faq__item[open] .faq__icon::after {
    rotate: 0deg;
    opacity: 0;
  }

  .faq__a {
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    gap: 0.75rem;
    padding-block: 0 clamp(1.1rem, 2.2vw, 1.5rem);
    padding-inline-end: 2.25rem;
    color: var(--fg-muted);
    animation: faq-open var(--dur-base) var(--ease-out);
  }

  .faq__a p {
    max-inline-size: 46em;
  }

  @keyframes faq-open {
    from {
      opacity: 0;
      translate: 0 -0.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__a {
      animation: none;
    }
  }
</style>
