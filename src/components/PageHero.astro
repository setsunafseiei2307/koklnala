---
import { Picture } from 'astro:assets';
import { imageSource } from '../lib/images';
import type { ImageId } from '../data/images';

interface Props {
  label: string;
  title: string;
  lead?: string;
  image: ImageId;
  /** パンくず（ホームは自動で先頭に付く） */
  crumb?: { label: string; href?: string }[];
  objectPosition?: string;
}

const { label, title, lead, image, crumb = [], objectPosition = 'center 55%' } = Astro.props;
---

<section class="phero" aria-labelledby="page-title">
  <div class="phero__media" aria-hidden="true">
    <Picture
      src={imageSource(image)}
      alt=""
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      widths={[640, 1024, 1440, 1800]}
      sizes="100vw"
      loading="eager"
      decoding="sync"
      fetchpriority="high"
      class="phero__img"
      style={`object-position:${objectPosition}`}
    />
    <div class="phero__scrim"></div>
  </div>

  <div class="shell phero__inner">
    <nav class="phero__crumb" aria-label="パンくずリスト">
      <ol>
        <li><a href="/">HOME</a></li>
        {
          crumb.map((item) => (
            <li>{item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>}</li>
          ))
        }
        <li aria-current="page">{label}</li>
      </ol>
    </nav>

    <p class="phero__label label label--accent">{label}</p>
    <h1 class="phero__title font-mincho" id="page-title">{title}</h1>
    {lead && <p class="phero__lead lead">{lead}</p>}
  </div>
</section>

<style>
  .phero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-block-size: clamp(24rem, 62svh, 38rem);
    padding-block: calc(var(--header-h) + 3rem) clamp(2.5rem, 6vw, 4.5rem);
    background: var(--c-obsidian);
    color: var(--c-ivory);
    overflow: hidden;
  }

  .phero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .phero__media picture {
    display: contents;
  }

  .phero__img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    scale: 1.04;
    animation: phero-settle 2200ms var(--ease-out) forwards;
  }

  @keyframes phero-settle {
    to {
      scale: 1;
    }
  }

  .phero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(8, 10, 9, 0.92) 0%,
      rgba(8, 10, 9, 0.6) 45%,
      rgba(8, 10, 9, 0.5) 100%
    );
  }

  .phero__inner {
    display: grid;
    gap: var(--sp-s);
  }

  .phero__crumb {
    margin-bottom: var(--sp-m);
  }

  .phero__crumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    font-family: var(--font-en);
    font-size: var(--fs-label);
    letter-spacing: 0.16em;
    color: rgba(236, 231, 221, 0.55);
  }

  .phero__crumb li + li::before {
    content: '/';
    margin-inline-end: 0.55rem;
    opacity: 0.5;
  }

  .phero__crumb a:hover {
    color: var(--c-ember-bright);
  }

  .phero__title {
    font-size: clamp(2.25rem, 7vw, 4.5rem);
    line-height: 1.24;
    letter-spacing: 0.06em;
  }

  .phero__lead {
    margin-top: var(--sp-s);
    color: rgba(236, 231, 221, 0.76);
  }

  @media (prefers-reduced-motion: reduce) {
    .phero__img {
      animation: none;
      scale: 1;
    }
  }
</style>
