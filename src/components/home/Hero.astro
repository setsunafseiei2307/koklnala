---
import { Picture } from 'astro:assets';
import { imageSource } from '../../lib/images';
import { getImage } from '../../data/images';
import { SITE } from '../../data/site';

const hero = getImage('hero');
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__media">
    <Picture
      src={imageSource('hero')}
      alt={hero.alt}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      widths={[640, 960, 1280, 1600, 1800]}
      sizes="100vw"
      loading="eager"
      decoding="sync"
      fetchpriority="high"
      class="hero__img"
      data-hero-img
    />
    <div class="hero__scrim" aria-hidden="true"></div>
  </div>

  <div class="hero__inner shell">
    <p class="hero__eyebrow label">{SITE.descriptor}</p>

    <h1 class="hero__title" id="hero-title">
      <span class="hero__brand font-en">EMBER<span class="hero__amp">&amp;</span>MOSS</span>
      <span class="hero__lead font-mincho">熱と静寂に泊まる。</span>
    </h1>

    <div class="hero__actions">
      <a class="btn btn--primary" href="/booking/"><span class="btn__label">空室・料金を見る</span></a>
      <a class="btn btn--ghost" href="/stay/"><span class="btn__label">滞在について</span></a>
    </div>
  </div>

  <a class="hero__scroll" href="#intro" aria-label="次のセクションへ進む">
    <span class="label">SCROLL</span>
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-block-size: 100svh;
    display: grid;
    align-items: end;
    isolation: isolate;
    overflow: hidden;
    background-color: var(--c-obsidian);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  /* <picture> は箱として扱わず、img を直接 media の子として伸ばす */
  .hero__media picture {
    display: contents;
  }

  .hero__img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    /* スマホは建物が寄って見えるよう右寄りにトリミング */
    object-position: 64% 42%;
    scale: 1.06;
    animation: hero-settle 2600ms var(--ease-out) 120ms forwards;
  }

  @keyframes hero-settle {
    to {
      scale: 1;
    }
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(8, 10, 9, 0.9) 0%, rgba(8, 10, 9, 0.72) 26%, rgba(8, 10, 9, 0.24) 62%, rgba(8, 10, 9, 0.5) 100%),
      radial-gradient(120% 80% at 78% 62%, rgba(184, 118, 67, 0.18), transparent 60%);
  }

  .hero__inner {
    padding-block: 0 clamp(4.5rem, 11vh, 7rem);
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
    justify-items: start;
  }

  .hero__eyebrow {
    color: rgba(236, 231, 221, 0.72);
  }

  .hero__title {
    display: grid;
    gap: clamp(0.75rem, 2vw, 1.25rem);
    margin: 0;
  }

  .hero__brand {
    font-size: clamp(0.8125rem, 2.4vw, 1.0625rem);
    font-weight: 400;
    letter-spacing: 0.42em;
    color: rgba(236, 231, 221, 0.85);
    text-transform: uppercase;
  }

  .hero__amp {
    font-family: var(--font-mincho);
    padding-inline: 0.5em;
    opacity: 0.6;
  }

  .hero__lead {
    font-size: clamp(2.5rem, 10.5vw, 7.25rem);
    font-weight: 400;
    line-height: 1.14;
    letter-spacing: 0.06em;
    color: var(--c-ivory);
    text-shadow: 0 1px 40px rgba(8, 10, 9, 0.4);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    inline-size: 100%;
    margin-top: clamp(0.5rem, 2vw, 1.5rem);
  }

  .hero__actions .btn {
    flex: 1 1 auto;
    min-inline-size: 13.5rem;
  }

  .hero__scroll {
    position: absolute;
    inset-block-end: clamp(1.5rem, 4vh, 2.5rem);
    inset-inline-end: var(--page-gutter);
    display: none;
    align-items: center;
    gap: 0.9rem;
    color: rgba(236, 231, 221, 0.7);
    min-block-size: var(--tap-min);
  }

  .hero__scroll-line {
    position: relative;
    inline-size: 4rem;
    block-size: 1px;
    background: rgba(236, 231, 221, 0.24);
    overflow: hidden;
  }

  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset-block: 0;
    inline-size: 45%;
    background: var(--c-ember);
    animation: scroll-hint 2400ms var(--ease-in-out) infinite;
  }

  @keyframes scroll-hint {
    0% {
      translate: -100% 0;
    }
    55%,
    100% {
      translate: 240% 0;
    }
  }

  .hero__scroll:hover {
    color: var(--c-ivory);
  }

  @media (min-width: 48em) {
    .hero__img {
      object-position: center 55%;
    }

    .hero__actions .btn {
      flex: 0 0 auto;
    }

    .hero__scroll {
      display: inline-flex;
    }
  }

  @media (min-width: 62em) {
    .hero__inner {
      padding-block-end: clamp(6.5rem, 15vh, 10rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__img {
      animation: none;
      scale: 1;
    }

    .hero__scroll-line::after {
      animation: none;
      inline-size: 100%;
      opacity: 0.5;
    }
  }
</style>
