---
import { Picture } from 'astro:assets';
import { imageSource } from '../lib/images';

interface Props {
  /** 直前のセクションと文脈がつながる一文 */
  eyebrow?: string;
  title?: string;
  lead?: string;
}

const {
  eyebrow = 'NEXT ESCAPE',
  title = '次の休日を、森の中へ。',
  lead = '空室のある日と、3 棟の空き状況を確認できます。ご予約は 2 日前まで承ります。',
} = Astro.props;
---

<section class="cta" aria-labelledby="cta-title">
  <div class="cta__media" aria-hidden="true">
    <Picture
      src={imageSource('night-exterior')}
      alt=""
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      widths={[640, 1024, 1440, 1800]}
      sizes="100vw"
      loading="lazy"
      decoding="async"
      class="cta__img"
    />
    <div class="cta__scrim"></div>
  </div>

  <div class="shell cta__inner">
    <p class="cta__eyebrow label label--accent" data-reveal>{eyebrow}</p>
    <h2 class="cta__title font-mincho" id="cta-title" data-reveal style="--reveal-delay:80ms">{title}</h2>
    <p class="cta__lead lead" data-reveal style="--reveal-delay:140ms">{lead}</p>
    <div class="cta__actions" data-reveal style="--reveal-delay:200ms">
      <a class="btn btn--primary" href="/booking/"><span class="btn__label">宿泊プランを見る</span></a>
      <a class="btn btn--ghost" href="/stay/"><span class="btn__label">客室を見る</span></a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    padding-block: clamp(5rem, 12vw, 9rem);
    background: var(--c-obsidian);
    color: var(--c-ivory);
    overflow: hidden;
  }

  .cta__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .cta__media picture {
    display: contents;
  }

  .cta__img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: center 60%;
  }

  .cta__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgba(8, 10, 9, 0.94) 0%, rgba(8, 10, 9, 0.72) 55%, rgba(8, 10, 9, 0.5) 100%),
      linear-gradient(to top, rgba(8, 10, 9, 0.85), transparent 55%);
  }

  .cta__inner {
    display: grid;
    gap: var(--sp-m);
    justify-items: start;
    max-inline-size: 46rem;
  }

  .cta__title {
    font-size: clamp(2rem, 7vw, 4.25rem);
    line-height: 1.3;
    letter-spacing: 0.08em;
  }

  .cta__lead {
    color: rgba(236, 231, 221, 0.72);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    inline-size: 100%;
    margin-top: var(--sp-s);
  }

  .cta__actions .btn {
    flex: 1 1 14rem;
  }

  @media (min-width: 48em) {
    .cta__actions .btn {
      flex: 0 0 auto;
      min-inline-size: 14rem;
    }
  }
</style>
