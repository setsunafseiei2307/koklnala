---
interface Props {
  /** 見出し要素の id。section の aria-labelledby から参照する */
  id?: string;
  label?: string;
  /** 英字の副題（装飾） */
  index?: string;
  title: string;
  lead?: string;
  align?: 'start' | 'center';
  /** 見出しの書体。明朝は大見出し用 */
  face?: 'mincho' | 'gothic';
  level?: 'h2' | 'h3';
  class?: string;
}

const {
  id,
  label,
  index,
  title,
  lead,
  align = 'start',
  face = 'mincho',
  level: Heading = 'h2',
  class: className = '',
} = Astro.props;
---

<div class:list={['sh', `sh--${align}`, className]} data-reveal>
  {
    (label || index) && (
      <p class="sh__meta">
        {index && <span class="sh__index num">{index}</span>}
        {label && <span class="label">{label}</span>}
      </p>
    )
  }
  <Heading id={id} class:list={['sh__title', 'h2', face === 'mincho' && 'font-mincho']}>{title}</Heading>
  {lead && <p class="sh__lead lead">{lead}</p>}
  <slot />
</div>

<style>
  .sh {
    display: grid;
    gap: var(--sp-m);
    max-inline-size: 46rem;
  }

  .sh--center {
    justify-items: center;
    text-align: center;
    margin-inline: auto;
  }

  .sh__meta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .sh__index {
    font-size: var(--fs-label);
    letter-spacing: 0.2em;
    color: var(--accent);
  }

  .sh__index::after {
    content: '';
    display: inline-block;
    inline-size: 1.75rem;
    block-size: 1px;
    background: currentColor;
    vertical-align: middle;
    margin-inline-start: 0.9rem;
    opacity: 0.6;
  }

  .sh__title {
    letter-spacing: 0.06em;
  }

  .sh__lead {
    color: var(--fg-muted);
  }
</style>
