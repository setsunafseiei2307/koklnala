---
import { NAV, SITE } from '../data/site';
import Logo from './Logo.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="header" data-header>
  <a class="skip-link" href="#main">本文へスキップ</a>

  <div class="header__inner">
    <a class="header__brand" href="/" aria-label={`${SITE.brand} ホームへ`}>
      <Logo />
    </a>

    <nav class="header__nav" aria-label="メインナビゲーション">
      <ul class="header__list">
        {
          NAV.map((item) => (
            <li>
              <a
                class="header__link"
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                <span class="header__link-en">{item.label}</span>
                <span class="header__link-ja">{item.labelJa}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <a class="header__book" href="/booking/">
        <span>BOOK YOUR STAY</span>
      </a>
      <button
        class="header__toggle"
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="global-menu"
      >
        <span class="header__toggle-label" data-menu-label>MENU</span>
        <span class="header__toggle-bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="header__progress" aria-hidden="true"><span data-scroll-progress></span></div>
</header>

<!-- フルスクリーンメニュー（モバイル / タブレット） -->
<div class="menu" id="global-menu" data-menu hidden>
  <div class="menu__inner">
    <nav aria-label="モバイルナビゲーション">
      <ul class="menu__list">
        {
          [...NAV, { href: '/booking/', label: 'BOOKING', labelJa: '空室・料金' }].map(
            (item, index) => (
              <li class="menu__item" style={`--i:${index}`}>
                <a class="menu__link" href={item.href}>
                  <span class="menu__no num">{String(index + 1).padStart(2, '0')}</span>
                  <span class="menu__label font-en">{item.label}</span>
                  <span class="menu__ja">{item.labelJa}</span>
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="menu__foot">
      <dl class="menu__facts small">
        <div><dt class="label">CHECK IN</dt><dd class="num">{SITE.checkIn}</dd></div>
        <div><dt class="label">CHECK OUT</dt><dd class="num">{SITE.checkOut}</dd></div>
        <div><dt class="label">VILLAS</dt><dd>{SITE.rooms}</dd></div>
      </dl>
      <a class="btn btn--primary btn--block" href="/booking/">
        <span class="btn__label">空室・料金を見る</span>
      </a>
    </div>
  </div>
</div>

<script>
  import { initHeader } from '../scripts/header';

  // View Transitions による遷移後も初期化する
  document.addEventListener('astro:page-load', initHeader);
</script>

<style>
  .header {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: var(--z-header);
    transition:
      background-color var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out),
      backdrop-filter var(--dur-base) var(--ease-out);
    border-bottom: 1px solid transparent;
  }

  /* スクロール後：背景を敷いて可読性を確保する */
  .header[data-state='scrolled'] {
    background-color: rgba(12, 14, 13, 0.86);
    border-bottom-color: var(--line);
    backdrop-filter: blur(14px);
  }

  .header[data-state='hidden'] {
    translate: 0 -100%;
    transition: translate var(--dur-base) var(--ease-out);
  }

  /*
   * メニューは全画面（--z-menu）なので、そのままだとヘッダーの閉じるボタンを
   * 覆ってしまい、開いたメニューを閉じられなくなる。展開中だけ前面に出す。
   */
  .header[data-menu-open] {
    z-index: calc(var(--z-menu) + 1);
    translate: none;
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-m);
    block-size: var(--header-h);
    padding-inline: var(--page-gutter);
    max-inline-size: var(--page-max);
    margin-inline: auto;
  }

  .header__brand {
    --logo-size: 0.875rem;
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap-min);
    color: var(--c-ivory);
  }

  .header__nav {
    display: none;
  }

  .header__list {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 2.4vw, 3rem);
    margin: 0;
  }

  .header__link {
    position: relative;
    display: grid;
    gap: 0.15em;
    padding-block: 0.9rem;
    color: var(--c-ivory);
  }

  .header__link-en {
    font-family: var(--font-en);
    font-size: var(--fs-label);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    line-height: 1;
  }

  .header__link-ja {
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    color: rgba(236, 231, 221, 0.5);
    line-height: 1;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .header__link::after {
    content: '';
    position: absolute;
    inset-block-end: 0.35rem;
    inset-inline-start: 0;
    inline-size: 100%;
    block-size: 1px;
    background: var(--c-ember);
    scale: 0 1;
    transform-origin: left;
    transition: scale var(--dur-base) var(--ease-out);
  }

  .header__link:hover::after,
  .header__link:focus-visible::after,
  .header__link[aria-current='page']::after {
    scale: 1 1;
  }

  .header__link:hover .header__link-ja {
    color: rgba(236, 231, 221, 0.8);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--sp-s);
  }

  .header__book {
    display: none;
    align-items: center;
    min-block-size: var(--tap-min);
    padding-inline: 1.5rem;
    border: 1px solid rgba(216, 208, 195, 0.34);
    font-family: var(--font-en);
    font-size: var(--fs-label);
    letter-spacing: 0.18em;
    color: var(--c-ivory);
    position: relative;
    overflow: hidden;
  }

  .header__book span {
    position: relative;
    z-index: 1;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .header__book::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--c-ember-deep);
    transform-origin: bottom;
    scale: 1 0;
    transition: scale var(--dur-base) var(--ease-out);
  }

  .header__book:hover::after,
  .header__book:focus-visible::after {
    scale: 1 1;
  }

  .header__book:hover span {
    color: #fff;
  }

  .header__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-block-size: var(--tap-min);
    min-inline-size: var(--tap-min);
    justify-content: flex-end;
    color: var(--c-ivory);
    font-family: var(--font-en);
    font-size: var(--fs-label);
    letter-spacing: 0.2em;
  }

  .header__toggle-bars {
    display: grid;
    gap: 5px;
    inline-size: 22px;
  }

  .header__toggle-bars i {
    block-size: 1px;
    background: currentColor;
    transition: translate var(--dur-base) var(--ease-out), rotate var(--dur-base) var(--ease-out);
  }

  [data-menu-open] .header__toggle-bars i:first-child {
    translate: 0 3px;
    rotate: 45deg;
  }

  [data-menu-open] .header__toggle-bars i:last-child {
    translate: 0 -3px;
    rotate: -45deg;
  }

  .header__progress {
    block-size: 1px;
    background: var(--line);
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
  }

  .header[data-state='scrolled'] .header__progress {
    opacity: 1;
  }

  .header__progress span {
    display: block;
    block-size: 100%;
    inline-size: var(--progress, 0%);
    background: var(--c-ember);
  }

  /* ---- フルスクリーンメニュー ---- */
  .menu {
    position: fixed;
    inset: 0;
    z-index: var(--z-menu);
    background: var(--c-obsidian);
    display: grid;
    align-items: end;
    padding-block: calc(var(--header-h) + var(--sp-l)) var(--sp-l);
    padding-inline: var(--page-gutter);
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .menu[data-open] {
    opacity: 1;
  }

  .menu__inner {
    display: grid;
    gap: var(--sp-xl);
    inline-size: 100%;
  }

  .menu__list {
    display: grid;
    gap: clamp(0.5rem, 2vw, 1.25rem);
    border-top: 1px solid var(--line);
  }

  .menu__item {
    border-bottom: 1px solid var(--line);
    opacity: 0;
    translate: 0 1rem;
    transition:
      opacity var(--dur-base) var(--ease-out),
      translate var(--dur-base) var(--ease-out);
    transition-delay: calc(var(--i) * 60ms + 80ms);
  }

  .menu[data-open] .menu__item {
    opacity: 1;
    translate: 0 0;
  }

  .menu__link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: clamp(0.9rem, 2.4vw, 1.4rem);
    min-block-size: var(--tap-min);
  }

  .menu__no {
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    color: var(--c-ember);
  }

  .menu__label {
    font-size: clamp(1.75rem, 8vw, 2.75rem);
    font-weight: 300;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .menu__ja {
    margin-inline-start: auto;
    font-size: var(--fs-small);
    color: var(--fg-muted);
  }

  .menu__foot {
    display: grid;
    gap: var(--sp-m);
  }

  .menu__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-s);
    margin: 0;
    padding-block-end: var(--sp-s);
    border-block-end: 1px solid var(--line);
  }

  .menu__facts div {
    display: grid;
    gap: 0.3rem;
  }

  /* 棟数は文字数が多いため 1 行使う */
  .menu__facts div:last-child {
    grid-column: 1 / -1;
  }

  .menu__facts dt {
    color: var(--fg-faint);
  }

  .menu__facts dd {
    margin: 0;
  }

  @media (min-width: 62em) {
    .header__nav,
    .header__book {
      display: flex;
    }

    .header__toggle {
      display: none;
    }
  }
</style>
