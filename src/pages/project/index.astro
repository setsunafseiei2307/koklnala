---
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import FinalCta from '../../components/FinalCta.astro';
import { SITE } from '../../data/site';

const roles = ['Direction', 'Information Architecture', 'UI / UX Design', 'Art Direction', 'Copywriting', 'Frontend Development', 'Interaction Design'];

/** 検証できる数値だけを並べる（成果を誇張しない） */
const metrics = [
  { value: '11', unit: 'ページ', label: 'SCOPE' },
  { value: '5', unit: 'ステップ', label: 'BOOKING UI' },
  { value: '49', unit: '件', label: 'AUTOMATED TESTS' },
  { value: '1/8', unit: 'に圧縮', label: 'JP WEBFONT' },
];

/** ブランド定義から情報設計までの、実案件と同じ手順 */
const foundation = [
  {
    no: '01',
    label: '課題',
    title: '写真が良いだけでは、予約されない。',
    body: '宿泊施設のサイトで離脱が起きるのは、たいてい「いくらか分からない」「自分の人数で泊まれるか分からない」地点です。写真の質より先に、その 2 つを解く導線を設計対象にしました。',
  },
  {
    no: '02',
    label: '想定ユーザー',
    title: '30〜40 代、2 名。スマホで探して、PC で決める。',
    body: '記念日や連休の宿を、通勤中にスマホで探す層を主役に置きました。だから比較表は横スクロールで、料金は入力したその場で動き、予約 UI はステップ形式です。',
  },
  {
    no: '03',
    label: 'ブランド設計',
    title: '足すのではなく、引いて決めた。',
    body: '「熱と静寂に泊まる。」を先に決め、そこから外れる要素を落としました。黒・森・石・木・熾火の 5 色、書体は 3 種類、アニメーションは出現と遷移のみ。高級感を演出で作らず、余白と比率で作る方針です。',
  },
  {
    no: '04',
    label: '情報設計',
    title: '読む順番を、意思決定の順番に合わせた。',
    body: 'ブランド理解 → 棟の比較 → サウナ → 滞在 → 料金 → アクセス → 写真 → FAQ → 予約。TOP はこの 9 段で構成し、各段の終わりに次の段への問いが残るようにコピーを置いています。',
  },
];

/** 写真は「生成して終わり」ではなく、用途から逆算して設計している */
const artDirection = [
  {
    label: '構図を用途から決める',
    body: '20 枚それぞれに、掲載面・アスペクト比・被写体の位置・光の時間帯を先に定義しました。HERO は 16:9 で右に建築・左に暗部、外気浴と森は 2:3 の縦、素材ディテールは 1:1。レイアウトが先で、写真は後です。',
  },
  {
    label: 'トーンを 1 本の撮影に揃える',
    body: '曇天と朝霧、日没直後の青い時間に限定し、彩度とコントラストを抑えています。1 枚ずつ良くするのではなく、20 枚を並べたときに同じ撮影に見えることを基準にしました。',
  },
  {
    label: 'Web 用に作り直す',
    body: '生成した原版をそのまま置かず、用途ごとに中央基準でトリミングして推奨サイズへ縮小し、WebP へ変換してから取り込んでいます。ビルド時に AVIF / WebP と srcset を自動生成し、掲載面ごとに sizes を指定しています。',
  },
  {
    label: '画面幅でトリミングを変える',
    body: '横長の原版をスマホの縦画面に置くと主役が切れるため、object-position を画面幅で切り替えています。HERO は狭い画面で建築側に寄せ、広い画面では中央へ戻します。',
  },
];

const decisions = [
  {
    no: '01',
    title: '「泊まりたい」から「予約」までを 1 本の線にした',
    body: 'TOP の途中に料金シミュレーターを置き、入力した条件を URL と localStorage で BOOKING ページへ引き継ぎます。価格の不安を、離脱ではなくその場の操作で解消させる設計です。',
  },
  {
    no: '02',
    title: '空室状況まで含めて「予約できる」体験にした',
    body: '日付を選ぶと 3 棟の空室状況が変わり、満室の棟は選択できなくなります。データは日付から決定的に生成した架空のもので、実在の在庫ではありませんが、予約エンジンとしての手ざわりを検証できるようにしています。',
  },
  {
    no: '03',
    title: 'スマホを主画面として設計した',
    body: '検討はスマホ、比較はデスクトップという前提で、画面下部の固定 CTA、44px 以上のタップ領域、横スクロールの比較表、ステップ形式の予約 UI を用意しています。',
  },
  {
    no: '04',
    title: '写真が主役でも速度を落とさない',
    body: 'AVIF / WebP の自動生成、srcset と sizes の指定、LCP 画像のみ eager 読み込み。日本語フォントはサイト内で使う文字だけにサブセット化し、フルセット 3.2MB を約 375KB（約 1/8）に抑えています。',
  },
  {
    no: '05',
    title: '架空であることを、伝える場所で伝える',
    body: '宿を見ている間は制作側の注釈を出さず、このページと、予約を確定する直前・完了画面で明示しています。隠さないことと、ブランド体験の途中で何度も水を差すことは別だと考えました。存在しない受賞歴や利用者数は掲載していません。',
  },
];

const stack = [
  { label: 'Framework', value: 'Astro（静的出力）' },
  { label: 'Language', value: 'TypeScript（strict）' },
  { label: 'Styling', value: 'CSS カスタムプロパティによる自作デザインシステム' },
  { label: 'JavaScript', value: '約 13〜16KB（gzip）/ UI ライブラリ・アニメーションライブラリなし' },
  { label: 'Images', value: 'astro:assets による AVIF / WebP 生成' },
  { label: 'Fonts', value: 'Jost / Zen Kaku Gothic New / しっぽり明朝（サブセット自己ホスト）' },
  { label: 'Testing', value: 'Vitest 22 件（料金ロジック）/ Playwright 27 件（予約フロー・表示検証）' },
  { label: 'Hosting', value: 'Cloudflare Workers（静的アセット配信）/ GitHub 連携で自動ビルド' },
];
---

<Base
  title="ABOUT THIS PROJECT / この制作について"
  description="EMBER & MOSS は実在しない宿泊施設です。Web サイトの設計・デザイン・実装力を示すために制作した自主制作（コンセプトプロジェクト）の背景と設計意図をまとめています。"
>
  <section class="phead" aria-labelledby="project-title">
    <div class="shell phead__inner">
      <nav class="phead__crumb" aria-label="パンくずリスト">
        <ol>
          <li><a href="/">HOME</a></li>
          <li aria-current="page">ABOUT THIS PROJECT</li>
        </ol>
      </nav>
      <p class="label label--accent">{SITE.conceptNotice.label}</p>
      <h1 class="phead__title font-mincho" id="project-title">この宿は、存在しません。</h1>
      <p class="phead__lead lead">{SITE.conceptNotice.long}</p>
      <p class="phead__note small">
        架空なのは施設だけです。要件定義・情報設計・アートディレクション・実装・検証は、実案件と同じ手順で進めています。
      </p>

      <dl class="phead__metrics">
        {
          metrics.map((metric) => (
            <div>
              <dt class="label">{metric.label}</dt>
              <dd>
                <span class="num phead__metric-value">{metric.value}</span>
                <span class="phead__metric-unit">{metric.unit}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section on-light" aria-labelledby="why-title">
    <div class="shell project__grid">
      <div>
        <SectionHeading
          id="why-title"
          index="01"
          label="BACKGROUND"
          title="なぜ架空の宿をつくったか。"
        />
        <p class="body">
          宿泊施設の Web サイトは、写真の力に頼るだけでは成立しません。部屋を比較でき、料金の見通しが立ち、スマートフォンで予約まで進める。その一連の流れを設計できるかどうかが、実際の受注では問われます。
        </p>
        <p class="body">
          実在の施設を題材にすると、掲載できる情報や表現に制約が出ます。そこで、条件をこちらで定義できる架空のブランドを立て、情報設計からコピー、実装、検証までを通しで行いました。
        </p>
      </div>

      <dl class="project__roles">
        <dt class="label">ROLE</dt>
        <dd>
          <ul>
            {roles.map((role) => <li>{role}</li>)}
          </ul>
        </dd>
        <dt class="label">TYPE</dt>
        <dd>Self-initiated concept project</dd>
        <dt class="label">CATEGORY</dt>
        <dd>Luxury Villa / Hospitality</dd>
        <dt class="label">PAGES</dt>
        <dd>全 11 ページ — TOP / STAY（一覧・詳細 3 棟）/ SAUNA / EXPERIENCE / ACCESS &amp; FAQ / BOOKING / ABOUT THIS PROJECT / 404</dd>
      </dl>
    </div>
  </section>

  <section class="section on-stone" aria-labelledby="approach-title">
    <div class="shell">
      <div class="project__head">
        <SectionHeading
          id="approach-title"
          index="02"
          label="APPROACH"
          title="課題から、画面までの順番。"
          lead="架空案件でも、決める順番は実案件と変えていません。誰の、どの迷いを、どの画面で解くのかを先に決めています。"
        />
      </div>

      <ol class="project__foundation">
        {
          foundation.map((item) => (
            <li data-reveal>
              <p class="project__foundation-meta">
                <span class="num project__no">{item.no}</span>
                <span class="label">{item.label}</span>
              </p>
              <h3 class="project__foundation-title font-mincho">{item.title}</h3>
              <p class="small">{item.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section on-forest" aria-labelledby="decision-title">
    <div class="shell">
      <div class="project__head">
        <SectionHeading
          id="decision-title"
          index="03"
          label="DESIGN DECISIONS"
          title="設計で決めたこと。"
        />
      </div>
      <ol class="project__decisions">
        {
          decisions.map((decision) => (
            <li data-reveal>
              <span class="num project__no">{decision.no}</span>
              <h3 class="project__decision-title">{decision.title}</h3>
              <p class="small">{decision.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section on-light" aria-labelledby="art-title">
    <div class="shell">
      <div class="project__head">
        <SectionHeading
          id="art-title"
          index="04"
          label="ART DIRECTION"
          title="写真は、レイアウトから逆算した。"
          lead="掲載している 20 枚は生成画像です。ただし「生成して貼る」ことはしていません。用途・比率・光・被写体の位置を先に定義し、Web に載る形まで作り込んでいます。"
        />
      </div>

      <ul class="project__art">
        {
          artDirection.map((item) => (
            <li data-reveal>
              <h3 class="project__art-title">{item.label}</h3>
              <p class="small">{item.body}</p>
            </li>
          ))
        }
      </ul>

      <p class="body project__note">
        1 枚の写真の良し悪しではなく、20 枚を通したときにひとつの宿に見えるかどうかを基準にしています。撮影指示書にあたる用途別のプロンプトと比率定義は、リポジトリの docs に置いています。
      </p>
    </div>
  </section>

  <section class="section on-stone" aria-labelledby="stack-title">
    <div class="shell project__grid">
      <div>
        <SectionHeading id="stack-title" index="05" label="TECH" title="使っている技術。" />
        <p class="body">
          派手さより、更新しやすさと表示速度を優先しています。アニメーションのためだけのライブラリは入れていません。
        </p>
        <p class="body">
          料金計算は型で守り、予約フローは自動テストで通しています。仕様が変わっても壊れたことに気づける状態を、納品物の一部と考えています。
        </p>
      </div>

      <dl class="project__stack">
        {
          stack.map((item) => (
            <div>
              <dt class="label">{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <FinalCta
    eyebrow="TRY THE FLOW"
    title="予約 UI を触ってみてください。"
    lead="日程と人数を入れると料金が変わります。送信は行われません。"
  />
</Base>

<style>
  .phead {
    padding-block: calc(var(--header-h) + clamp(3rem, 8vw, 5rem)) clamp(2.5rem, 6vw, 4rem);
    background:
      radial-gradient(70% 60% at 85% 0%, rgba(184, 118, 67, 0.12), transparent 62%),
      var(--c-obsidian);
    border-block-end: 1px solid var(--line);
  }

  .phead__inner {
    display: grid;
    gap: var(--sp-m);
    max-inline-size: 54rem;
  }

  .phead__crumb ol {
    display: flex;
    gap: 0.55rem;
    font-family: var(--font-en);
    font-size: var(--fs-label);
    letter-spacing: 0.16em;
    color: var(--fg-faint);
  }

  .phead__crumb a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap-min);
  }

  .phead__crumb li {
    display: flex;
    align-items: center;
  }

  .phead__crumb li + li::before {
    content: '/';
    margin-inline-end: 0.55rem;
    opacity: 0.5;
  }

  .phead__title {
    font-size: clamp(2rem, 6.5vw, 3.75rem);
    line-height: 1.28;
    letter-spacing: 0.06em;
  }

  .phead__lead {
    color: var(--fg-muted);
  }

  .phead__note {
    color: var(--fg-faint);
    max-inline-size: 46em;
    line-height: 1.9;
  }

  .phead__metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-s) var(--sp-m);
    margin: var(--sp-s) 0 0;
    padding-block-start: var(--sp-m);
    border-block-start: 1px solid var(--line);
  }

  .phead__metrics div {
    display: grid;
    gap: 0.35rem;
  }

  .phead__metrics dd {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .phead__metric-value {
    font-size: clamp(1.5rem, 4vw, 2rem);
    line-height: 1;
    color: var(--c-ivory);
  }

  .phead__metric-unit {
    font-size: var(--fs-small);
    color: var(--fg-faint);
  }

  .project__foundation,
  .project__art {
    display: grid;
    gap: 0;
    border-block-start: 1px solid var(--line);
  }

  .project__foundation li,
  .project__art li {
    display: grid;
    gap: 0.5rem;
    padding-block: clamp(1.25rem, 3vw, 2rem);
    border-block-end: 1px solid var(--line);
  }

  .project__foundation-meta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .project__foundation-meta .label {
    color: var(--fg-faint);
  }

  .project__foundation-title {
    font-size: var(--fs-h3);
    line-height: 1.5;
    letter-spacing: 0.04em;
  }

  .project__art-title {
    font-size: var(--fs-lead);
    line-height: 1.5;
    letter-spacing: 0.05em;
  }

  .project__foundation p.small,
  .project__art p.small {
    color: var(--fg-muted);
    max-inline-size: 44em;
  }

  .project__art + .project__note {
    margin-top: clamp(2rem, 4vw, 3rem);
    max-inline-size: 48em;
  }

  .project__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }

  .project__grid p.body {
    margin-top: var(--sp-m);
  }

  .project__note {
    padding-inline-start: 1rem;
    border-inline-start: 1px solid var(--accent);
  }

  .project__roles,
  .project__stack {
    display: grid;
    margin: 0;
    border-block-start: 1px solid var(--line);
  }

  .project__roles dt,
  .project__roles dd {
    padding-block: 0.85rem;
    border-block-end: 1px solid var(--line);
    margin: 0;
    font-size: var(--fs-small);
  }

  .project__roles dt {
    color: var(--fg-faint);
    padding-block-end: 0.35rem;
    border-block-end: none;
  }

  .project__roles ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
  }

  .project__stack div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--sp-s);
    padding-block: 0.85rem;
    border-block-end: 1px solid var(--line);
    font-size: var(--fs-small);
  }

  .project__stack dd {
    margin: 0;
  }

  .project__head {
    margin-bottom: clamp(2rem, 4.5vw, 3.5rem);
  }

  .project__decisions {
    display: grid;
    gap: 0;
    border-block-start: 1px solid var(--line);
  }

  .project__decisions li {
    display: grid;
    gap: 0.5rem;
    padding-block: clamp(1.25rem, 3vw, 2rem);
    border-block-end: 1px solid var(--line);
  }

  .project__no {
    font-size: var(--fs-label);
    letter-spacing: 0.2em;
    color: var(--accent);
  }

  .project__decision-title {
    font-size: var(--fs-lead);
    letter-spacing: 0.05em;
    line-height: 1.6;
  }

  .project__decisions p {
    color: var(--fg-muted);
    max-inline-size: 48em;
  }

  @media (min-width: 48em) {
    .phead__metrics {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 62em) {
    .project__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      column-gap: clamp(3rem, 6vw, 6rem);
    }

    .project__decisions,
    .project__foundation,
    .project__art {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(2.5rem, 5vw, 4rem);
    }
  }
</style>
